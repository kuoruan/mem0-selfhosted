OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false

# Path to a JSON file with auth settings (jwt_secret, admin_api_key, oidc providers).
# See docs for the full schema. When set, JSON values override the env vars above.
# AUTH_CONFIG_PATH=/app/auth_config.json

# Public origin the browser uses to reach this server (used for OIDC redirect_uri).
# In production behind a reverse proxy this MUST be set (e.g. https://api.example.com)
# so the IdP redirects back to the correct origin. When unset, inferred from the request.
# SERVER_URL=https://api.example.com
#
# Trusted reverse-proxy IPs for honoring X-Forwarded-* headers (rate limiting +
# OIDC redirect origin inference). Comma-separated IPs/CIDRs, or "*" to trust all.
# Default 127.0.0.1. Mirrors uvicorn's proxy-headers trust setting; the forwarded
# host must still match the DASHBOARD_URL hostname or it is rejected.
# FORWARDED_ALLOW_IPS=127.0.0.1
#
# OIDC_ALLOWED_SIGNING_ALGS=RS256
# Restrict ID-token signing algorithms to this allowlist (comma-separated).
# Intersected with the IdP's advertised algorithms; default RS256. Raises if
# the IdP only offers algorithms outside this list.

DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Legal values: 1/true/yes/on to enable, 0/false/no/off to disable.
# Other values (e.g. "enabled") are treated as false with a warning.
MEM0_TELEMETRY=true

# Log level for uvicorn and application logs. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30

# Enable automatic request-log pruning in the background task.
# Legal values: 1/true/yes/on to enable, 0/false/no/off to disable.
# Other values are treated as false with a warning.
REQUEST_LOG_PRUNE_ENABLED=true
